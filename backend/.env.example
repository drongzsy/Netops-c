# Database
DATABASE_URL=mysql+pymysql://netops:netops123@localhost:3306/netops_cmnet?charset=utf8mb4

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_EXPIRE_MINUTES=480

# Ansible execution mode: wsl / ssh / local
ANSIBLE_MODE=wsl
ANSIBLE_WSL_PROJECT_PATH=/mnt/c/Users/CMCC/netops-cmnet

# SSH jump host (for reaching eNSP devices)
ANSIBLE_JUMP_HOST=
ANSIBLE_JUMP_USER=sun
ANSIBLE_JUMP_PASS=Qwe123

# Remote Ansible controller (used when ANSIBLE_MODE=ssh)
ANSIBLE_REMOTE_HOST=
ANSIBLE_REMOTE_USER=
ANSIBLE_REMOTE_KEY=

# Agent API (empty = disable API-Key auth, agents must use JWT)
AGENT_API_KEY=cmnet-agent-key-2026

# CORS
CORS_ORIGINS=http://localhost:5173
